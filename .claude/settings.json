{
  "permissions": {
    "allow": [
      "Bash(node .claude/skills/design-from-references/scripts/contrast.js:*)",
      "Bash(node .claude/skills/design-from-references/scripts/datasetTally.js:*)",
      "Bash(node .claude/skills/design-from-references/scripts/designNotesScan.js:*)",
      "Bash(node .claude/skills/design-from-references/scripts/nameCheck.js:*)",
      "Bash(npm test:*)",
      "mcp__plugin_figma_figma__get_screenshot"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*figma.*__create_new_file",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/nameGate.js\"",
            "timeout": 15,
            "statusMessage": "Checking the file name for AI tells"
          }
        ]
      }
    ]
  }
}
